# Database
DATABASE_URL=postgresql+asyncpg://invoices_user:invoices_pass@localhost:5432/invoices_db
POSTGRES_DB=invoices_db
POSTGRES_USER=invoices_user
POSTGRES_PASSWORD=invoices_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# MinIO
MINIO_URL=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=invoices
MINIO_SECURE=false

# JWT
JWT_SECRET=supersecretjwtkey_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Service URLs
AUTH_SERVICE_URL=http://localhost:8001
DOCUMENT_SERVICE_URL=http://localhost:8002
SEGMENTATION_SERVICE_URL=http://localhost:8003
OCR_SERVICE_URL=http://localhost:8004
MATERIALS_SERVICE_URL=http://localhost:8005
HOMOLOGATION_SERVICE_URL=http://localhost:8006
REVIEW_SERVICE_URL=http://localhost:8007
DESTINATIONS_SERVICE_URL=http://localhost:8008
ANALYTICS_SERVICE_URL=http://localhost:8009

# App settings
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS — en producción especificar el dominio real del frontend
# ENVIRONMENT=production activará esta restricción
CORS_ORIGINS=http://localhost:3000
