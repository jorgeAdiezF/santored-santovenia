# ── WhatsApp / Meta Cloud API ─────────────────────────────────
WHATSAPP_TOKEN=tu_access_token_permanente
WHATSAPP_PHONE_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=token_secreto_para_verificar_webhook

# ── Claude / Anthropic ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Servidor ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Empresa (personaliza el bot) ─────────────────────────────
COMPANY_NAME=Santored Santovenia
COMPANY_PHONE=+34 900 000 000
COMPANY_EMAIL=info@santored.com

# ── Notificaciones por email ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password

EMAIL_ADMIN=admin@santored.com
EMAIL_TECNICO=tecnico@santored.com
EMAIL_COMERCIAL=comercial@santored.com

# ── Base de datos ─────────────────────────────────────────────
DB_PATH=./data/bot.db
